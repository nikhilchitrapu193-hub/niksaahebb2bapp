{
  "name": "fresh-supply",
  "version": "1.0.0",
  "description": "B2B food supply ordering platform: restaurant, admin and delivery apps on Supabase. No build step, no AI, no framework.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/dev-server.js",
    "test": "node --test tests/*.test.js",
    "test:log": "node --test --test-reporter=tap tests/*.test.js 2>&1 | node scripts/test-logger.js",
    "atlas": "node tools/appatlas/cli.js build",
    "atlas:check": "node tools/appatlas/cli.js check"
  },
  "devDependencies": {
    "jsdom": "^26.0.0"
  }
}
