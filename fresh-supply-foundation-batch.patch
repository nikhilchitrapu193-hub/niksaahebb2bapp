+++ b/web/js/core/csv.js
@@ -0,0 +1,35 @@
+// =============================================================================
+// csv.js — "Export to CSV" for any list. toCsv() is pure (unit-tested);
+// downloadCsv() hands the file to the browser. Opens directly in Excel.
+//
+// columns: [{ key: 'order_number', label: 'Order' }, { key: 'total', label: 'Total', value: (row) => ... }]
+// A column's `value` function wins over `key` when present.
+// =============================================================================
+
+/** Quote a cell the way Excel expects: wrap in quotes, double inner quotes. */
+function cell(value) {
+  if (value === null || value === undefined) return '';
+  const text = String(value);
+  return /[",\r\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
+}
+
+/** Build CSV text (with a header row) from rows and column definitions. */
+export function toCsv(rows, columns) {
+  const header = columns.map((c) => cell(c.label)).join(',');
+  const lines = rows.map((row) => columns.map((c) => cell(c.value ? c.value(row) : row[c.key])).join(','));
+  return [header, ...lines].join('\r\n');
+}
+
+/** Trigger a download of `rows` as `filename` (add .csv yourself). */
+export function downloadCsv(filename, rows, columns) {
+  // The BOM makes Excel read ₹ and other non-ASCII characters correctly.
+  const blob = new Blob(['﻿' + toCsv(rows, columns)], { type: 'text/csv;charset=utf-8' });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = filename;
+  document.body.append(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+}
diff --git a/web/js/core/permissions.js b/web/js/core/permissions.js
new file mode 100644
index 0000000..88cf521
--- /dev/null
+++ b/web/js/core/permissions.js
@@ -0,0 +1,29 @@
+// =============================================================================
+// permissions.js — "may this user do that?" for the admin app's menus and
+// buttons. Pure functions, no DOM, no network.
+//
+// The database is the real gatekeeper (has_permission() in migration 006);
+// these helpers only decide what to SHOW. `me.permissions` is a Set of
+// 'module:action' strings loaded by auth.loadCurrentUser() for admin users.
+// =============================================================================
+
+import { MODULES } from './config.js';
+
+/** True when `me` may perform `action` in `module`. Super admins may do everything. */
+export function can(me, module, action) {
+  if (!me?.profile || me.profile.role !== 'admin') return false;
+  if (me.profile.team_role === 'super_admin') return true;
+  return me.permissions?.has(`${module}:${action}`) ?? false;
+}
+
+/** Admin nav links for the modules `me` may view, in MODULES order. */
+export function visibleNav(me) {
+  return Object.entries(MODULES)
+    .filter(([code, m]) => m.nav && can(me, code, 'view'))
+    .map(([, m]) => ({ href: m.nav, label: m.label }));
+}
+
+/** Turn role_permissions rows [{module, action}] into the Set `can()` reads. */
+export function toPermissionSet(rows) {
+  return new Set((rows ?? []).map((r) => `${r.module}:${r.action}`));
+}
